{
  "manifest_version": 3,
  "name": "Pocket Evo 站点导入插件",
  "version": "1.0.0",
  "description": "从已登录的 PT 站点生成 Pocket Evo 导入二维码",
  "permissions": [
    "tabs",
    "scripting",
    "cookies",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "打开 Pocket Evo 站点导入插件",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "assets/background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "assets/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "assets/visit.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
